# Backend base URL (no trailing slash). Leave unset in local dev to use same-origin /api + Nitro (see server/routes).
# NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
#
# Снимок API в data/api-snapshot: npm run api-snapshot (по умолч. бэк http://localhost:8000, см. API_SNAPSHOT_BASE_URL).
# Прод: NUXT_API_SNAPSHOT=1, NUXT_PUBLIC_API_BASE_URL пусто (запросы /api/v2/… с Nuxt), при необходимости API_SNAPSHOT_DATA_DIR=…
# NUXT_API_SNAPSHOT=0
# NUXT_API_BACKEND_URL=http://localhost:8000
# API_SNAPSHOT_DATA_DIR=

# API version segment: /api/v2/...
NUXT_PUBLIC_API_VERSION=v2

# Optional: Authorization: Token … (if your stand requires auth for categories/products)
# NUXT_PUBLIC_API_TOKEN=

# R2 CDN origin for media/image URLs (rewrites /media/… from the API).
NUXT_PUBLIC_MEDIA_BASE_URL=https://media.pazl-ai.com

# === Telegram Bot интеграция ===
# Токен бота — нужен для валидации Telegram WebApp initData (sync-cart) и отправки уведомлений (web-order)
BOT_TOKEN=
# URL HTTP API бота для синхронизации корзины (в Docker: http://bot:8080, локально: http://localhost:8080)
BOT_API_URL=http://localhost:8080/api/sync-cart
# ID администраторов (через запятую) — получают уведомления о заказах с сайта
ADMIN_IDS=

